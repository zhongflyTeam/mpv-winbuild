Subject: [PATCH] svtav1: drop explicitly -DENABLE_AVX512=ON to fix aarch64
 build

---
 packages/svtav1.cmake | 1 -
 1 file changed, 1 deletion(-)

diff --git a/packages/svtav1.cmake b/packages/svtav1.cmake
index 87aa1d4..f5c768d 100644
--- a/packages/svtav1.cmake
+++ b/packages/svtav1.cmake
@@ -12,7 +12,6 @@ ExternalProject_Add(svtav1
         -DCMAKE_INSTALL_PREFIX=${MINGW_INSTALL_PREFIX}
         -DCMAKE_FIND_ROOT_PATH=${MINGW_INSTALL_PREFIX}
         -DBUILD_SHARED_LIBS=OFF
-        -DENABLE_AVX512=ON
         -DBUILD_TESTING=OFF
         -DBUILD_ENC=ON
         -DSVT_AV1_LTO=OFF
